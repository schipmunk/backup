#!/bin/bash

#Define the file and pattern
tv_status=$(umbriel config get output.HDMI-A-1.enabled)

if [[ $tv_status == "true" ]]; then
    umbriel config set output.HDMI-A-1.enabled false
    notify-send "Output Changed" "TV is Off"
else
    umbriel config set output.HDMI-A-1.enabled true
    notify-send "Output Changed" "TV is On"
fi
